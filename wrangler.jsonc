{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskforce-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskforce-dashboard-db",
      "database_id": "5835b382-fd07-49e5-9497-c83230e25da5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Taskforce Dashboard"
  }
}
